#include <stdio.h>

int main() {
    FILE *fp;
    
    int a[] = {0, 1, 2};
    char b[] = "ABC";
    float c[] = {1.1f, 1.2f, 1.3f};

    fp = fopen("a.bin", "wb");
    if (fp == NULL) {
        printf("無法建立檔案 a.bin\n");
        return 1;
    }

    fwrite(a, sizeof(int), 3, fp);
    fwrite(b, sizeof(char), 3, fp);
    fwrite(c, sizeof(float), 3, fp);

    fclose(fp);
    printf("成功寫入 a.bin\n");

    return 0;
}
